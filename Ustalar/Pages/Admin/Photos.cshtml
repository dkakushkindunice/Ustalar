@page "/admin/photos"
@model Ustalar.Pages.Admin.PhotosModel
@{
    ViewData["Title"] = "Fotolar — Admin";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
        <a href="/admin" class="text-gray-400 hover:text-gray-600 text-sm">← Admin panel</a>
        <h1 class="text-xl font-bold text-gray-900">Foto moderasiyası</h1>
    </div>

    @if (!Model.PendingPhotos.Any())
    {
        <div class="bg-white rounded-xl border border-gray-100 p-8 text-center text-gray-400">
            Gözləyən foto yoxdur
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            @foreach (var photo in Model.PendingPhotos)
            {
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                    <img src="@photo.ThumbnailUrl" alt="Portfolio"
                         class="w-full aspect-square object-cover" loading="lazy" />
                    <div class="p-3">
                        <p class="text-xs text-gray-500 mb-2">@photo.Master?.FullName</p>
                        <div class="flex gap-2">
                            <form method="post" asp-page-handler="Approve" asp-route-id="@photo.Id" class="flex-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white text-xs py-1.5 rounded-lg transition">
                                    Təsdiqlə
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@photo.Id" class="flex-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white text-xs py-1.5 rounded-lg transition">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
