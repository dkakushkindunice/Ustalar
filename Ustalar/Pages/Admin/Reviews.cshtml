@page "/admin/reviews"
@model Ustalar.Pages.Admin.ReviewsModel
@{
    ViewData["Title"] = "Rəylər — Admin";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex items-center gap-4 mb-6">
        <a href="/admin" class="text-gray-400 hover:text-gray-600 text-sm">← Admin panel</a>
        <h1 class="text-xl font-bold text-gray-900">Rəylər moderasiyası</h1>
    </div>

    @if (!Model.PendingReviews.Any())
    {
        <div class="bg-white rounded-xl border border-gray-100 p-8 text-center text-gray-400">
            Gözləyən rəy yoxdur
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var review in Model.PendingReviews)
            {
                <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
                    <div class="flex items-start justify-between">
                        <div>
                            <p class="font-medium text-gray-900">@review.ReviewerName</p>
                            <p class="text-sm text-gray-400">@review.ReviewerPhone · @review.CreatedAt.ToString("dd.MM.yyyy")</p>
                            <p class="text-yellow-400 mt-1">@string.Concat(Enumerable.Repeat("★", review.Rating))</p>
                            @if (!string.IsNullOrEmpty(review.Text))
                            {
                                <p class="text-sm text-gray-600 mt-2">@review.Text</p>
                            }
                            <p class="text-xs text-gray-400 mt-2">
                                Usta: <a href="/masters/@review.Master?.City?.Slug/usta/@review.MasterId"
                                         class="text-orange-600 hover:underline">@review.Master?.FullName</a>
                            </p>
                        </div>
                        <div class="flex gap-2 flex-shrink-0 ml-4">
                            <form method="post" asp-page-handler="Approve" asp-route-id="@review.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bg-green-500 hover:bg-green-600 text-white text-xs px-3 py-1.5 rounded-lg transition">
                                    Təsdiqlə
                                </button>
                            </form>
                            <form method="post" asp-page-handler="Reject" asp-route-id="@review.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-xs px-3 py-1.5 rounded-lg transition">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
