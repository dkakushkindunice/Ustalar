@page "/cabinet/edit"
@model Ustalar.Pages.Cabinet.EditModel
@{
    ViewData["Title"] = Localizer["EditProfile"] + " — Ustalar.az";
}

<div class="max-w-xl mx-auto mt-10 px-4 pb-16">
    <div class="flex items-center gap-3 mb-8">
        <a href="/cabinet" class="text-gray-400 hover:text-gray-600">@Localizer["Back"]</a>
        <h1 class="text-xl font-bold text-gray-900">@Localizer["EditProfile"]</h1>
    </div>

    <form method="post" asp-page-handler="UploadAvatar" enctype="multipart/form-data"
          class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-4">
        @Html.AntiForgeryToken()
        <h2 class="font-semibold text-gray-900 mb-3">@Localizer["Avatar"]</h2>
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="avatar"
                 class="w-20 h-20 rounded-full object-cover mb-3" />
        }
        @if (!string.IsNullOrEmpty(Model.AvatarError))
        {
            <p class="text-sm text-red-600 mb-2">@Model.AvatarError</p>
        }
        <div class="flex items-center gap-3">
            <input type="file" name="Avatar" accept="image/jpeg,image/png,image/webp"
                   class="text-sm text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg
                          file:border-0 file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100" />
            <button type="submit"
                    class="bg-orange-600 hover:bg-orange-700 text-white text-sm px-4 py-1.5 rounded-lg transition">
                @Localizer["Upload"]
            </button>
        </div>
    </form>

    <form method="post" class="space-y-5 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["About"]</label>
            <textarea asp-for="Input.About" rows="4"
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500"
                      placeholder="@Localizer["AboutPlaceholder"]"></textarea>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
            <input asp-for="Input.Whatsapp" type="tel" placeholder="+994501234567"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["ExperienceYears"]</label>
            <input asp-for="Input.ExperienceYears" type="number" min="0" max="60"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["PriceMinShort"]</label>
                <input asp-for="Input.PriceFrom" type="number" min="0"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["PriceMaxShort"]</label>
                <input asp-for="Input.PriceTo" type="number" min="0"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
            </div>
        </div>

        <button type="submit"
                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg px-4 py-3 transition">
            @Localizer["Save"]
        </button>
    </form>
</div>
