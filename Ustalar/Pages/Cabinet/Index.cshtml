@page "/cabinet"
@model Ustalar.Pages.Cabinet.IndexModel
@{
    ViewData["Title"] = Localizer["Cabinet"] + " — Ustalar.az";
}

<div class="max-w-2xl mx-auto mt-10 px-4 pb-16">

    @if (Model.Master.Status == Ustalar.Models.MasterStatus.Pending)
    {
        <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-lg px-4 py-3 mb-6 text-sm">
            @Localizer["ProfilePending"]
        </div>
    }
    else if (Model.Master.Status == Ustalar.Models.MasterStatus.Blocked)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6 text-sm">
            @Localizer["ProfileBlocked"]
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
        <div class="flex items-center justify-between mb-4">
            <h1 class="text-xl font-bold text-gray-900">@Model.Master.FullName</h1>
            <a href="/cabinet/edit"
               class="text-sm text-orange-600 hover:text-orange-700 font-medium">@Localizer["Edit"]</a>
        </div>

        <div class="grid grid-cols-2 gap-4 text-sm text-gray-600">
            <div>
                <span class="font-medium text-gray-700">@Localizer["Phone"]:</span>
                @Model.Master.Phone
            </div>
            <div>
                <span class="font-medium text-gray-700">@Localizer["City"]:</span>
                @Model.Master.City?.GetName()
            </div>
            @if (Model.Master.ExperienceYears.HasValue)
            {
                <div>
                    <span class="font-medium text-gray-700">@Localizer["Experience"]:</span>
                    @Model.Master.ExperienceYears @Localizer["YearsExp"]
                </div>
            }
            @if (Model.Master.PriceFrom.HasValue || Model.Master.PriceTo.HasValue)
            {
                <div>
                    <span class="font-medium text-gray-700">@Localizer["Price"]:</span>
                    @(Model.Master.PriceFrom?.ToString("0") ?? "—") –
                    @(Model.Master.PriceTo?.ToString("0") ?? "—") AZN
                </div>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Master.About))
        {
            <p class="mt-4 text-sm text-gray-600">@Model.Master.About</p>
        }

        @if (Model.Master.MasterSpecializations.Any())
        {
            <div class="mt-4 flex flex-wrap gap-2">
                @foreach (var ms in Model.Master.MasterSpecializations)
                {
                    <span class="bg-orange-50 text-orange-700 text-xs px-3 py-1 rounded-full">
                        @ms.Specialization.GetName()
                    </span>
                }
            </div>
        }
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-semibold text-gray-900">@Localizer["Portfolio"]</h2>
            <a href="/cabinet/photos/upload"
               class="text-sm bg-orange-600 hover:bg-orange-700 text-white px-3 py-1.5 rounded-lg transition">
                @Localizer["AddPhoto"]
            </a>
        </div>

        @if (!Model.Master.PortfolioPhotos.Any())
        {
            <p class="text-sm text-gray-400">@Localizer["NoPhotos"]</p>
        }
        else
        {
            <div class="grid grid-cols-3 gap-2">
                @foreach (var photo in Model.Master.PortfolioPhotos)
                {
                    <div class="relative aspect-square group">
                        <img src="@photo.ThumbnailUrl" alt="Portfolio"
                             class="w-full h-full object-cover rounded-lg" loading="lazy" />
                        @if (!photo.IsApproved)
                        {
                            <span class="absolute top-1 left-1 bg-yellow-400 text-yellow-900 text-xs px-1.5 py-0.5 rounded">
                                @Localizer["Pending"]
                            </span>
                        }
                        <form method="post" asp-page-handler="DeletePhoto"
                              class="absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition"
                              onsubmit="return confirm('@Localizer["DeletePhotoConfirm"]')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="photoId" value="@photo.Id" />
                            <button type="submit"
                                    class="bg-red-500 hover:bg-red-600 text-white rounded p-1 text-xs leading-none">
                                ✕
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>

    <form method="post" asp-page-handler="Logout" class="mt-6">
        @Html.AntiForgeryToken()
        <button type="submit" class="text-sm text-gray-400 hover:text-red-500 transition">
            @Localizer["Logout"]
        </button>
    </form>
</div>
