@page "/error/404"
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["PageNotFound"] + " — Ustalar.az";
}

<div class="max-w-lg mx-auto mt-20 px-4 text-center">
    <div class="text-8xl font-bold text-orange-600 mb-4">404</div>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">@Localizer["PageNotFound"]</h1>
    <p class="text-gray-500 mb-8">@Localizer["PageNotFoundMsg"]</p>
    <a href="/" class="inline-block bg-orange-600 hover:bg-orange-700 text-white font-medium px-6 py-3 rounded-xl transition">
        @Localizer["BackToHome"]
    </a>
</div>
