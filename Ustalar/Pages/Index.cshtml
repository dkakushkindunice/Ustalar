@page "/"
@model Ustalar.Pages.IndexModel
@{
    ViewData["Title"] = "Ustalar.az — " + Localizer["HeroTitle"];
}

@section Head {
    <meta name="description" content="@Localizer["HeroSubtitle"]" />
    <link rel="alternate" hreflang="az" href="https://ustalar.az/" />
    <link rel="alternate" hreflang="ru" href="https://ustalar.az/?culture=ru" />
}

<section class="bg-gradient-to-br from-orange-50 to-white py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
            @Localizer["HeroTitle"]
        </h1>
        <p class="text-lg text-gray-500 mb-8">
            @Localizer["HeroSubtitle"]
        </p>
        <form action="/masters" method="get" class="flex gap-2 max-w-xl mx-auto">
            <select name="specSlug"
                    class="flex-1 border border-gray-300 rounded-xl px-4 py-3 text-gray-700 focus:outline-none focus:ring-2 focus:ring-orange-500">
                <option value="">@Localizer["SelectSpec"]</option>
                @foreach (var spec in Model.PopularSpecs)
                {
                    <option value="@spec.Slug">@spec.GetName()</option>
                }
            </select>
            <button type="submit"
                    class="bg-orange-600 hover:bg-orange-700 text-white font-semibold px-6 py-3 rounded-xl transition">
                @Localizer["Search"]
            </button>
        </form>
    </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-12">
    <h2 class="text-xl font-bold text-gray-900 mb-6">@Localizer["PopularSpecs"]</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-3">
        @foreach (var spec in Model.PopularSpecs)
        {
            <a href="/masters/@spec.Slug"
               class="bg-white border border-gray-100 rounded-xl p-4 text-center hover:border-orange-200 hover:shadow-sm transition">
                <p class="text-sm font-medium text-gray-800">@spec.GetName()</p>
            </a>
        }
    </div>
</section>

@if (Model.FeaturedMasters.Any())
{
    <section class="max-w-7xl mx-auto px-4 pb-16">
        <h2 class="text-xl font-bold text-gray-900 mb-6">@Localizer["VerifiedMasters"]</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var master in Model.FeaturedMasters)
            {
                var citySlug = master.City?.Slug ?? "baku";
                var specSlug = master.MasterSpecializations.FirstOrDefault()?.Specialization?.Slug ?? "usta";
                <a href="/masters/@citySlug/@specSlug/@master.Id"
                   class="bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition p-5 flex items-center gap-4">
                    <div class="w-14 h-14 rounded-full bg-gray-100 overflow-hidden flex-shrink-0">
                        @if (!string.IsNullOrEmpty(master.AvatarUrl))
                        {
                            <img src="@master.AvatarUrl" alt="@master.FullName" class="w-full h-full object-cover" loading="lazy" />
                        }
                        else
                        {
                            <span class="w-full h-full flex items-center justify-center text-2xl text-gray-300">👤</span>
                        }
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900 text-sm">@master.FullName <span class="text-orange-500 text-xs">✓</span></p>
                        <p class="text-xs text-gray-400">@master.City?.GetName()</p>
                        @if (master.MasterSpecializations.Any())
                        {
                            <p class="text-xs text-orange-600 mt-0.5">@master.MasterSpecializations.First().Specialization?.GetName()</p>
                        }
                    </div>
                </a>
            }
        </div>
        <div class="text-center mt-8">
            <a href="/masters" class="inline-block border border-orange-600 text-orange-600 hover:bg-orange-600 hover:text-white font-medium px-8 py-3 rounded-xl transition">
                @Localizer["AllMasters"]
            </a>
        </div>
    </section>
}
