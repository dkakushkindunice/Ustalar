@page "/masters/{citySlug}"
@model Ustalar.Pages.Masters.CityModel
@{
    ViewData["Title"] = $"{Model.CurrentCity?.GetName() ?? Localizer["Masters"].Value} — Ustalar.az";
}

@section Head {
    <link rel="canonical" href="https://ustalar.az/masters/@Model.CurrentCity?.Slug" />
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-400 mb-4 flex gap-1 items-center">
        <a href="/masters" class="hover:text-orange-600">@Localizer["Masters"]</a>
        <span>›</span>
        <span class="text-gray-700">@Model.CurrentCity?.GetName()</span>
    </nav>

    <h1 class="text-2xl font-bold text-gray-900 mb-6">@Model.CurrentCity?.GetName() — @Localizer["Masters"]</h1>

    <div class="flex flex-wrap gap-3 mb-6">
        <select onchange="if(this.value) window.location='/masters/@Model.CurrentCity?.Slug/'+this.value"
                class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
            <option value="">@Localizer["AllSpecs"]</option>
            @foreach (var spec in Model.Catalog.Specializations)
            {
                <option value="@spec.Slug">@spec.GetName()</option>
            }
        </select>
    </div>

    <div id="masters-list">
        @await Html.PartialAsync("_MastersList", Model.Catalog)
    </div>
</div>
