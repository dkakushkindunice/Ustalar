@page "/masters/{citySlug}/{specSlug}"
@model Ustalar.Pages.Masters.CitySpecModel
@{
    ViewData["Title"] = $"{Model.CurrentSpec?.GetName()} — {Model.CurrentCity?.GetName()} — Ustalar.az";
}

@section Head {
    <link rel="canonical" href="https://ustalar.az/masters/@Model.CurrentCity?.Slug/@Model.CurrentSpec?.Slug" />
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <nav class="text-sm text-gray-400 mb-4 flex gap-1 items-center">
        <a href="/masters" class="hover:text-orange-600">@Localizer["Masters"]</a>
        <span>›</span>
        <a href="/masters/@Model.CurrentCity?.Slug" class="hover:text-orange-600">@Model.CurrentCity?.GetName()</a>
        <span>›</span>
        <span class="text-gray-700">@Model.CurrentSpec?.GetName()</span>
    </nav>

    <h1 class="text-2xl font-bold text-gray-900 mb-6">
        @Model.CurrentCity?.GetName() — @Model.CurrentSpec?.GetName()
    </h1>

    <div id="masters-list">
        @await Html.PartialAsync("_MastersList", Model.Catalog)
    </div>
</div>
