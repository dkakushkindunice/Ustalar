@page "/masters"
@model Ustalar.Pages.Masters.IndexModel
@{
    ViewData["Title"] = "Ustalar kataloqu — Ustalar.az";
}

<div class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Ustalar kataloqu</h1>

    <!-- Фильтры -->
    <div class="flex flex-wrap gap-3 mb-6">
        <select id="filter-city"
                hx-get="/masters"
                hx-target="#masters-list"
                hx-push-url="true"
                hx-include="#filter-city,#filter-spec"
                name="citySlug"
                class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
            <option value="">Bütün şəhərlər</option>
            @foreach (var city in Model.Cities)
            {
                <option value="@city.Slug" selected="@(Model.CurrentCitySlug == city.Slug)">
                    @city.NameAz
                </option>
            }
        </select>

        <select id="filter-spec"
                hx-get="/masters"
                hx-target="#masters-list"
                hx-push-url="true"
                hx-include="#filter-city,#filter-spec"
                name="specSlug"
                class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-500">
            <option value="">Bütün ixtisaslar</option>
            @foreach (var spec in Model.Specializations)
            {
                <option value="@spec.Slug" selected="@(Model.CurrentSpecSlug == spec.Slug)">
                    @spec.NameAz
                </option>
            }
        </select>
    </div>

    <!-- Список мастеров (заменяется HTMX) -->
    <div id="masters-list">
        @await Html.PartialAsync("_MastersList", Model)
    </div>
</div>
