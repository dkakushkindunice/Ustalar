@page "/register"
@model Ustalar.Pages.Register.IndexModel
@{
    ViewData["Title"] = "Qeydiyyat — Ustalar.az";
}

<div class="max-w-md mx-auto mt-16 px-4">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Usta kimi qeydiyyat</h1>
    <p class="text-gray-500 mb-8">Nömrənizi daxil edin, SMS göndərəcəyik</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.DevCode))
    {
        <div class="bg-green-50 border border-green-300 text-green-800 rounded-lg px-4 py-3 mb-6">
            <p class="font-semibold mb-1">🛠 Development: SMS göndərilmədi</p>
            <p>Kod: <span class="font-mono font-bold text-xl tracking-widest">@Model.DevCode</span></p>
            <a href="/register/step2" class="mt-2 inline-block text-sm underline">Step 2 →</a>
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">
                Telefon nömrəsi
            </label>
            <input asp-for="Phone"
                   type="tel"
                   placeholder="+994501234567"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                   required />
            <span asp-validation-for="Phone" class="text-red-500 text-sm"></span>
        </div>
        <button type="submit"
                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg px-4 py-3 transition">
            SMS göndər
        </button>
    </form>
</div>
