@page "/register/step2"
@model Ustalar.Pages.Register.Step2Model
@{
    ViewData["Title"] = Localizer["EnterCode"] + " — Ustalar.az";
}

<div class="max-w-md mx-auto mt-16 px-4">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">@Localizer["EnterCode"]</h1>
    <p class="text-gray-500 mb-8">
        <strong>@Model.Phone</strong> @Localizer["SentCodeTo"]
    </p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Phone" value="@Model.Phone" />
        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["SmsCode"]</label>
            <input asp-for="Code"
                   type="text"
                   inputmode="numeric"
                   maxlength="6"
                   placeholder="000000"
                   class="w-full border border-gray-300 rounded-lg px-4 py-3 text-2xl text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-orange-500"
                   required
                   autocomplete="one-time-code" />
        </div>
        <button type="submit"
                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg px-4 py-3 transition">
            @Localizer["Confirm"]
        </button>
        <a href="/register" class="block text-center text-sm text-gray-500 hover:text-orange-600 mt-4">
            @Localizer["ResendCode"]
        </a>
    </form>
</div>
