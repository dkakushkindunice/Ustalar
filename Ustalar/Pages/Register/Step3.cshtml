@page "/register/step3"
@model Ustalar.Pages.Register.Step3Model
@{
    ViewData["Title"] = Localizer["CreateProfile"] + " — Ustalar.az";
}

<div class="max-w-xl mx-auto mt-12 px-4 pb-16">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">@Localizer["CreateProfile"]</h1>
    <p class="text-gray-500 mb-8">@Localizer["ProfileSubtitle"]</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-6">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["FullName"] *</label>
            <input asp-for="Input.FullName" type="text"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" required />
            <span asp-validation-for="Input.FullName" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["City"] *</label>
            <select asp-for="Input.CityId" asp-items="Model.Cities"
                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" required>
                <option value="">@Localizer["SelectCity"]</option>
            </select>
            <span asp-validation-for="Input.CityId" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">@Localizer["Specializations"] * (@Localizer["CanSelectMultiple"])</label>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var spec in Model.Specializations)
                {
                    <label class="flex items-center gap-2 border border-gray-200 rounded-lg px-3 py-2 cursor-pointer hover:bg-orange-50">
                        <input type="checkbox" name="Input.SpecializationIds" value="@spec.Value"
                               class="accent-orange-600" />
                        <span class="text-sm">@spec.Text</span>
                    </label>
                }
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["About"]</label>
            <textarea asp-for="Input.About" rows="3"
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500"
                      placeholder="@Localizer["AboutPlaceholder"]"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["ExperienceYears"]</label>
                <input asp-for="Input.ExperienceYears" type="number" min="0" max="60"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
                <input asp-for="Input.Whatsapp" type="tel" placeholder="+994501234567"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["PriceMin"]</label>
                <input asp-for="Input.PriceFrom" type="number" min="0"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@Localizer["PriceMax"]</label>
                <input asp-for="Input.PriceTo" type="number" min="0"
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-orange-500" />
            </div>
        </div>

        <button type="submit"
                class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold rounded-lg px-4 py-3 transition">
            @Localizer["CreateProfile"]
        </button>
    </form>
</div>
