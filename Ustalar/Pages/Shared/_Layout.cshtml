<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Ustalar.az</title>

    <!-- Tailwind CSS v4 -->
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />

    <!-- GLightbox -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-gray-50">
    @{
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var returnUrl = Uri.EscapeDataString(Context.Request.Path);
        var isMaster = User.Identity?.IsAuthenticated == true && User.Identity.AuthenticationType == "MasterCookie";
        var currentPath = Context.Request.Path.Value ?? "";
        var isMastersActive = currentPath.StartsWith("/masters");
        var isCabinetActive = currentPath.StartsWith("/cabinet");
        var isRegisterActive = currentPath.StartsWith("/register");
    }

    <!-- ===== HEADER (desktop) ===== -->
    <header class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">

            <a href="/" class="text-xl font-bold text-orange-600 tracking-tight">Ustalar.az</a>

            <!-- Desktop nav (md и выше) -->
            <nav class="hidden md:flex items-center gap-6 text-sm">
                <a href="/masters"
                   class="font-medium transition-colors @(isMastersActive ? "text-orange-600" : "text-gray-600 hover:text-orange-600")">
                    @Localizer["Masters"]
                </a>
                @if (isMaster)
                {
                    <a href="/cabinet"
                       class="font-medium transition-colors @(isCabinetActive ? "text-orange-600" : "text-gray-600 hover:text-orange-600")">
                        @Localizer["Cabinet"]
                    </a>
                    <span class="text-gray-400 text-xs border border-gray-200 rounded-full px-2 py-0.5">
                        @(User.Identity.Name?.Length > 12 ? User.Identity.Name[..12] + "…" : User.Identity.Name)
                    </span>
                }
                else
                {
                    <a href="/register"
                       class="font-medium transition-colors @(isRegisterActive ? "text-orange-600" : "text-gray-600 hover:text-orange-600")">
                        @Localizer["Register"]
                    </a>
                }

                <!-- Переключатель языка (десктоп) -->
                <div class="flex text-xs border border-gray-200 rounded-lg overflow-hidden">
                    <a href="/culture/set?culture=az&returnUrl=@returnUrl"
                       class="px-2.5 py-1.5 font-medium transition-colors @(currentCulture == "az" ? "bg-orange-600 text-white" : "text-gray-500 hover:bg-gray-50")">AZ</a>
                    <a href="/culture/set?culture=ru&returnUrl=@returnUrl"
                       class="px-2.5 py-1.5 font-medium transition-colors @(currentCulture == "ru" ? "bg-orange-600 text-white" : "text-gray-500 hover:bg-gray-50")">RU</a>
                </div>
            </nav>

            <!-- Mobile header: только логотип, меню — снизу -->
            <div class="flex md:hidden items-center">
                <span class="text-xs text-gray-400">Ustalar.az</span>
            </div>

        </div>
    </header>

    <!-- ===== MAIN ===== -->
    <main class="min-h-screen pb-14 md:pb-0">
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="bg-white border-t border-gray-200 mt-12 mb-14 md:mb-0">
        <div class="max-w-7xl mx-auto px-6 py-6 text-center text-sm text-gray-500">
            &copy; 2026 Ustalar.az
        </div>
    </footer>

    <!-- ===== MOBILE BOTTOM NAV (до md) ===== -->
    <nav class="fixed bottom-0 left-0 right-0 w-full h-14 bg-white border-t border-gray-200 flex md:hidden z-50"
         style="padding-bottom: env(safe-area-inset-bottom)">

        <!-- Мастера -->
        <a href="/masters"
           class="flex-1 h-full flex flex-col items-center justify-center gap-0.5 transition-colors @(isMastersActive ? "text-orange-600" : "text-gray-400 hover:text-orange-600")">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
            </svg>
            <span class="text-[10px] font-medium">@Localizer["Masters"]</span>
        </a>

        <!-- Язык -->
        <div class="flex-1 h-full flex flex-col items-center justify-center gap-1">
            <div class="flex text-[10px] border border-gray-200 rounded-md overflow-hidden">
                <a href="/culture/set?culture=az&returnUrl=@returnUrl"
                   class="px-1.5 py-0.5 font-medium @(currentCulture == "az" ? "bg-orange-600 text-white" : "text-gray-500")">AZ</a>
                <a href="/culture/set?culture=ru&returnUrl=@returnUrl"
                   class="px-1.5 py-0.5 font-medium @(currentCulture == "ru" ? "bg-orange-600 text-white" : "text-gray-500")">RU</a>
            </div>
            <span class="text-[10px] text-gray-400">Lang</span>
        </div>

        <!-- Кабинет / Регистрация -->
        @if (isMaster)
        {
            <a href="/cabinet"
               class="flex-1 h-full flex flex-col items-center justify-center gap-0.5 transition-colors @(isCabinetActive ? "text-orange-600" : "text-gray-400 hover:text-orange-600")">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.5 20.25a8.25 8.25 0 0 1 15 0"/>
                </svg>
                <span class="text-[10px] font-medium">@(User.Identity.Name?.Length > 8 ? User.Identity.Name[..8] + "…" : User.Identity.Name)</span>
            </a>
        }
        else
        {
            <a href="/register"
               class="flex-1 h-full flex flex-col items-center justify-center gap-0.5 transition-colors @(isRegisterActive ? "text-orange-600" : "text-gray-400 hover:text-orange-600")">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.5 20.25a8.25 8.25 0 0 1 15 0"/>
                </svg>
                <span class="text-[10px] font-medium">@Localizer["Register"]</span>
            </a>
        }
    </nav>

    <!-- HTMX 2.0 -->
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <!-- Alpine.js 3.14 -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
    <!-- GLightbox -->
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
