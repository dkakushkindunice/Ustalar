<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Ustalar.az</title>

    <!-- Tailwind CSS v4 -->
    <link rel="stylesheet" href="~/css/app.min.css" asp-append-version="true" />

    <!-- GLightbox -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @{
        var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var returnUrl = Uri.EscapeDataString(Context.Request.Path);
        var isMaster = User.Identity?.IsAuthenticated == true && User.Identity.AuthenticationType == "MasterCookie";
        var currentPath = Context.Request.Path.Value ?? "";
        var isMastersActive = currentPath.StartsWith("/masters");
        var isCabinetActive = currentPath.StartsWith("/cabinet");
        var isRegisterActive = currentPath.StartsWith("/register");
    }

    <header class="bg-white border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <a href="/" class="text-xl font-bold text-orange-600">Ustalar.az</a>

            <!-- Desktop nav -->
            <nav class="hidden md:flex gap-4 text-sm items-center">
                <a href="/masters" class="@(isMastersActive ? "text-orange-600 font-medium" : "text-gray-600 hover:text-orange-600")">@Localizer["Masters"]</a>
                @if (isMaster)
                {
                    <span class="text-gray-500">@(User.Identity.Name?.Length > 8 ? User.Identity.Name[..8] + "…" : User.Identity.Name)</span>
                    <a href="/cabinet" class="@(isCabinetActive ? "text-orange-600 font-medium" : "text-gray-600 hover:text-orange-600")">@Localizer["Cabinet"]</a>
                }
                else
                {
                    <a href="/register" class="@(isRegisterActive ? "text-orange-600 font-medium" : "text-gray-600 hover:text-orange-600")">@Localizer["Register"]</a>
                }
                <div class="flex gap-1 text-xs border border-gray-200 rounded-lg overflow-hidden">
                    <a href="/culture/set?culture=az&returnUrl=@returnUrl" class="px-2 py-1 @(currentCulture == "az" ? "bg-orange-600 text-white" : "text-gray-500 hover:bg-gray-50")">AZ</a>
                    <a href="/culture/set?culture=ru&returnUrl=@returnUrl" class="px-2 py-1 @(currentCulture == "ru" ? "bg-orange-600 text-white" : "text-gray-500 hover:bg-gray-50")">RU</a>
                </div>
            </nav>

        </div>
    </header>

    <main class="min-h-screen bg-gray-50 pb-14 md:pb-0">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-gray-200 mt-12 mb-14 md:mb-0">
        <div class="max-w-7xl mx-auto px-4 py-6 text-center text-sm text-gray-500">
            &copy; 2026 Ustalar.az
        </div>
    </footer>

    <!-- Mobile bottom nav -->
    <nav class="fixed bottom-0 left-0 right-0 w-full bg-white border-t border-gray-200 flex md:hidden z-50 h-14" style="padding-bottom: env(safe-area-inset-bottom)">
        <!-- Мастера -->
        <a href="/masters" class="flex-1 h-full flex flex-col items-center justify-center gap-0.5 transition @(isMastersActive ? "text-orange-600" : "text-gray-400 hover:text-orange-600")">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
            </svg>
            <span class="text-[10px] font-medium">@Localizer["Masters"]</span>
        </a>

        <!-- Переключатель языка -->
        <div class="flex-1 h-full flex flex-col items-center justify-center gap-0.5">
            <div class="flex gap-1 text-[10px] border border-gray-200 rounded-md overflow-hidden">
                <a href="/culture/set?culture=az&returnUrl=@returnUrl" class="px-1.5 py-0.5 @(currentCulture == "az" ? "bg-orange-600 text-white" : "text-gray-500")">AZ</a>
                <a href="/culture/set?culture=ru&returnUrl=@returnUrl" class="px-1.5 py-0.5 @(currentCulture == "ru" ? "bg-orange-600 text-white" : "text-gray-500")">RU</a>
            </div>
            <span class="text-[10px] text-gray-400">Lang</span>
        </div>

        <!-- Кабинет / Регистрация -->
        @if (isMaster)
        {
            <a href="/cabinet" class="flex-1 flex flex-col items-center h-full flex flex-col items-center justify-center gap-0.5 transition @(isCabinetActive ? "text-orange-600" : "text-gray-400 hover:text-orange-600")">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.5 20.25a8.25 8.25 0 0 1 15 0"/>
                </svg>
                <span class="text-[10px] font-medium">@(User.Identity.Name?.Length > 8 ? User.Identity.Name[..8] + "…" : User.Identity.Name)</span>
            </a>
        }
        else
        {
            <a href="/register" class="flex-1 flex flex-col items-center h-full flex flex-col items-center justify-center gap-0.5 transition @(isRegisterActive ? "text-orange-600" : "text-gray-400 hover:text-orange-600")">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0zM4.5 20.25a8.25 8.25 0 0 1 15 0"/>
                </svg>
                <span class="text-[10px] font-medium">@Localizer["Register"]</span>
            </a>
        }
    </nav>

    <!-- HTMX 2.0 -->
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <!-- Alpine.js 3.14 -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.9/dist/cdn.min.js"></script>
    <!-- GLightbox -->
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
