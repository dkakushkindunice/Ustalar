@page "/sitemap.xml"
@model Ustalar.Pages.SitemapModel
@{
    Layout = null;
    Response.ContentType = "application/xml";
}<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://ustalar.az/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://ustalar.az/masters</loc>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
  @foreach (var city in Model.Cities)
  {
    <url>
      <loc>https://ustalar.az/masters/@city.Slug</loc>
      <changefreq>hourly</changefreq>
      <priority>0.8</priority>
    </url>
    @foreach (var spec in Model.Specializations)
    {
      <url>
        <loc>https://ustalar.az/masters/@city.Slug/@spec.Slug</loc>
        <changefreq>hourly</changefreq>
        <priority>0.7</priority>
      </url>
    }
  }
  @foreach (var master in Model.ActiveMasters)
  {
    <url>
      <loc>https://ustalar.az/masters/@master.CitySlug/@master.SpecSlug/@master.MasterId</loc>
      <changefreq>weekly</changefreq>
      <priority>0.6</priority>
    </url>
  }
</urlset>
